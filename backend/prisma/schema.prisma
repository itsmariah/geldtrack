generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                     Int               @id @default(autoincrement())
  nome                   String
  email                  String            @unique
  senha                  String
  foto                   String?
  resetTokenHash         String?           @unique
  resetTokenExpiresAt    DateTime?
  // Incrementado sempre que a senha muda — tokens JWT emitidos antes disso
  // carregam a versão antiga e são recusados por authMiddleware.
  tokenVersion           Int               @default(0)
  createdAt              DateTime          @default(now())
  // Todo usuário pertence a exatamente uma família (a "família pessoal" criada no
  // registro, ou uma compartilhada depois de entrar com um código) — nunca mais de uma,
  // sem seletor de workspace.
  familiaId              Int
  familia                Familia           @relation(fields: [familiaId], references: [id], onDelete: Restrict)
  // "dono" pode remover membros, renomear a família e regenerar o código; "membro" só
  // mexe nos dados (criar/editar/excluir), igual a um dono, mas não na família em si.
  papelFamilia           String            @default("dono")
  // Resumo periódico por e-mail (opt-in, desligado por padrão). Disparado por um workflow
  // agendado do GitHub Actions que chama POST /api/resumos/enviar (ver routes/resumos.js).
  // ultimoResumo* = período já enviado (segunda-feira da semana / YYYY-MM) — deixa o envio
  // idempotente, mesmo se o workflow rodar mais de uma vez ou atrasar.
  resumoSemanal          Boolean           @default(false)
  resumoMensal           Boolean           @default(false)
  ultimoResumoSemanal    String?
  ultimoResumoMensal     String?
  transacoes             Transacao[]
  metas                  Meta[]
  orcamentos             Orcamento[]
  recorrencias           Recorrencia[]
  contas                 Conta[]
  transferencias         Transferencia[]
  conexoesBancarias      ConexaoBancaria[]
  categorias             Categoria[]
  eventos                Evento[]
  grupoMembros           GrupoMembro[]
  gruposCriados          Grupo[]           @relation("GrupoCriador")
  despesasGrupoCriadas   DespesaGrupo[]    @relation("DespesaGrupoCriador")
  pagamentosGrupoCriados PagamentoGrupo[]  @relation("PagamentoGrupoCriador")
}

// Uma "carteira" compartilhada entre 1+ usuários. Toda visibilidade/posse de dado
// financeiro passa a ser por familiaId, não por usuarioId (que continua existindo nas
// tabelas abaixo só como atribuição — "quem lançou" — não como controle de acesso).
model Familia {
  id                Int               @id @default(autoincrement())
  nome              String
  // Código curto compartilhado fora do app (ex: WhatsApp) pra outra pessoa entrar —
  // sem convite por e-mail, sem token com expiração.
  codigo            String            @unique
  createdAt         DateTime          @default(now())
  membros           Usuario[]
  categorias        Categoria[]
  transacoes        Transacao[]
  contas            Conta[]
  conexoesBancarias ConexaoBancaria[]
  transferencias    Transferencia[]
  recorrencias      Recorrencia[]
  metas             Meta[]
  orcamentos        Orcamento[]
  eventos           Evento[]
}

// Metadados de exibição (ícone/cor) por categoria — de propósito NÃO é uma foreign key
// de Transacao/Recorrencia/Orcamento, que continuam guardando categoria como texto livre
// (como sempre foi). Isso evita qualquer migração/backfill em cima de dados reais: uma
// categoria sem linha correspondente aqui simplesmente cai num ícone/cor padrão.
model Categoria {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  familiaId Int
  nome      String
  tipo      String
  icone     String   @default("💰")
  cor       String   @default("#6366f1")
  createdAt DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  familia   Familia  @relation(fields: [familiaId], references: [id], onDelete: Cascade)

  @@unique([familiaId, nome, tipo])
}

model Transacao {
  id                  Int                  @id @default(autoincrement())
  usuarioId           Int
  familiaId           Int
  familia             Familia              @relation(fields: [familiaId], references: [id], onDelete: Cascade)
  tipo                String
  valor               Decimal              @db.Decimal(12, 2)
  categoria           String
  descricao           String               @default("")
  data                String
  createdAt           DateTime             @default(now())
  // Atualizado automaticamente pelo Prisma em todo update() — usado só pra sinalizar "editada"
  // na lista; o que mudou de fato fica no histórico (TransacaoHistorico).
  updatedAt           DateTime             @default(now()) @updatedAt
  // Posição manual dentro do mesmo dia (maior = mais acima na lista) — definida quando o
  // usuário arrasta transações do mesmo dia no Dashboard. Empates (ex: tudo 0, o default
  // de transações antigas/importadas) caem no createdAt desc, a ordem de sempre.
  ordem               Int                  @default(0)
  usuario             Usuario              @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  recorrenciaId       Int?
  // SetNull (não Cascade): apagar a regra de recorrência não deve apagar o histórico
  // de transações já lançadas a partir dela.
  recorrencia         Recorrencia?         @relation(fields: [recorrenciaId], references: [id], onDelete: SetNull)
  contaId             Int
  conta               Conta                @relation(fields: [contaId], references: [id], onDelete: Cascade)
  // Etiqueta opcional pra agrupar a transação dentro de um Evento (ex: "Viagem Rio 2026").
  // SetNull (não Cascade): apagar o evento não deve apagar as transações já lançadas nele.
  eventoId            Int?
  evento              Evento?              @relation(fields: [eventoId], references: [id], onDelete: SetNull)
  // Preenchido quando a transação nasceu de "Adicionar despesas ao dashboard" num Grupo —
  // guarda a parte do usuário naquela despesa, com a mesma data dela. SetNull (não Cascade):
  // excluir a despesa ou o grupo inteiro depois que a atividade acabou não deve apagar o
  // gasto que já foi pro dashboard. O @@unique abaixo impede importar a mesma despesa duas
  // vezes pro mesmo usuário (cada membro importa a própria parte).
  despesaGrupoId      Int?
  despesaGrupo        DespesaGrupo?        @relation(fields: [despesaGrupoId], references: [id], onDelete: SetNull)
  // Mesma ideia, pra receita: um pagamento que o usuário RECEBEU num grupo, adicionado ao
  // dashboard por ele (botão por pagamento, nunca automático — ver POST
  // /grupos/:id/pagamentos/:pagamentoId/dashboard). SetNull pelo mesmo motivo acima.
  pagamentoGrupoId    Int?
  pagamentoGrupo      PagamentoGrupo?      @relation(fields: [pagamentoGrupoId], references: [id], onDelete: SetNull)
  // Preenchidos quando o valor foi convertido de outra moeda (hoje: parte de uma despesa de
  // grupo em € lançada numa conta em R$). "valor" continua sempre na moeda da conta — saldo e
  // relatórios não mudam; isto é só o registro de onde o número veio, pra exibir "US$ 20,00
  // (R$ 103,62 de acordo com a cotação de 30/09/2026)" e pra reconverter na sincronização.
  // taxaConversao = quantas unidades da moeda da conta vale 1 unidade de moedaOriginal.
  // dataCotacao nula = câmbio informado à mão pelo usuário (não a cotação salva).
  moedaOriginal       String?
  valorOriginal       Decimal?             @db.Decimal(12, 2)
  taxaConversao       Decimal?             @db.Decimal(12, 6)
  dataCotacao         String?
  // Preenchido só em transações vindas de sincronização Open Finance — usado pra nunca
  // importar a mesma transação duas vezes num novo sync (upsert idempotente).
  pluggyTransactionId String?              @unique
  // Comprovante anexado (data URL base64, imagem ou PDF) — nunca incluído nas consultas
  // de listagem/export (só via GET /transactions/:id/anexo), pra não pesar a paginação.
  anexo               String?
  anexoNome           String?
  historico           TransacaoHistorico[]

  @@unique([despesaGrupoId, usuarioId])
  @@unique([pagamentoGrupoId, usuarioId])
}

// Um registro por edição que muda pelo menos um campo financeiro (tipo/valor/categoria/
// descricao/data/contaId) — não registra troca de anexo, pra não guardar base64 no histórico.
// "alteracoes" é a lista de { campo, de, para } daquela edição específica.
model TransacaoHistorico {
  id          Int       @id @default(autoincrement())
  transacaoId Int
  transacao   Transacao @relation(fields: [transacaoId], references: [id], onDelete: Cascade)
  alteracoes  Json
  createdAt   DateTime  @default(now())
}

// Conta/carteira do usuário (conta corrente, cartão, dinheiro em espécie...). saldoInicial
// é o valor que a conta já tinha antes de começar a ser rastreada aqui — o saldo exibido
// nunca é guardado, é sempre saldoInicial + receitas - despesas dessa conta (± transferências).
model Conta {
  id                    Int              @id @default(autoincrement())
  usuarioId             Int
  familiaId             Int
  nome                  String
  tipo                  String
  saldoInicial          Decimal          @default(0) @db.Decimal(12, 2)
  // Fixada na criação, nunca muda depois (mesmo princípio de Recorrencia.dataInicio) —
  // mudar a moeda de uma conta com transações já lançadas corromperia a leitura do
  // histórico. Ver utils/moedas.js pra lista de moedas suportadas.
  moeda                 String           @default("BRL")
  // Só visual: contas com a mesma instituição aparecem agrupadas na tela de Contas (ex:
  // "Wise · Real", "Wise · Dólar" e "Wise · Euro" debaixo de "Wise"). Texto livre, opcional
  // e editável — diferente de moeda, não muda a interpretação de nada já lançado.
  instituicao           String?
  createdAt             DateTime         @default(now())
  // Posição manual na tela (arrastar e soltar) — menor = mais acima. Reordenar grava
  // -n..-1 (ver utils/reorderLista.js), então registro novo (default 0) entra no fim sem
  // ninguém calcular "próxima posição"; empates caem no createdAt asc (ordem de criação).
  ordem                 Int              @default(0)
  usuario               Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  familia               Familia          @relation(fields: [familiaId], references: [id], onDelete: Cascade)
  transacoes            Transacao[]
  transferenciasSaida   Transferencia[]  @relation("TransferenciasSaida")
  transferenciasEntrada Transferencia[]  @relation("TransferenciasEntrada")
  recorrencias          Recorrencia[]
  // Preenchidos só quando a conta nasceu de uma sincronização Open Finance (Pluggy).
  // SetNull: apagar a conexão bancária não apaga a conta nem o histórico importado.
  pluggyAccountId       String?          @unique
  conexaoId             Int?
  conexao               ConexaoBancaria? @relation(fields: [conexaoId], references: [id], onDelete: SetNull)
}

// Uma conexão com um banco via Open Finance (Pluggy). Uma conexão pode alimentar mais de
// uma Conta local (ex: conta corrente + cartão de crédito do mesmo banco). Nenhum dado
// bancário sensível (senha, token de acesso ao banco) é guardado aqui — só o identificador
// do Item na Pluggy, que por si só não dá acesso a nada sem a API key do servidor.
model ConexaoBancaria {
  id                  Int       @id @default(autoincrement())
  usuarioId           Int
  familiaId           Int
  pluggyItemId        String    @unique
  nomeConector        String
  status              String
  erro                String?
  ultimaSincronizacao DateTime?
  createdAt           DateTime  @default(now())
  usuario             Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  familia             Familia   @relation(fields: [familiaId], references: [id], onDelete: Cascade)
  contas              Conta[]
}

// Movimentação entre duas contas do mesmo usuário — nunca gera Transacao (não é receita
// nem despesa de verdade, só troca de "bolso"), então não aparece nos relatórios de
// receita/despesa, só no saldo de cada conta envolvida.
model Transferencia {
  id             Int      @id @default(autoincrement())
  usuarioId      Int
  familiaId      Int
  contaOrigemId  Int
  contaDestinoId Int
  // Sempre na moeda da conta de origem (o que saiu).
  valor          Decimal  @db.Decimal(12, 2)
  // Só preenchido quando as contas têm moedas diferentes: quanto chegou na conta de
  // destino, na moeda dela (ex: saiu R$ 400, chegou US$ 72,30). Informado pelo usuário, não
  // calculado pela cotação — o câmbio real já embute spread/IOF/taxas do banco. Nulo = mesma
  // moeda, chegou exatamente "valor" (é o caso de toda transferência antiga).
  valorDestino   Decimal? @db.Decimal(12, 2)
  data           String
  descricao      String   @default("")
  createdAt      DateTime @default(now())
  usuario        Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  familia        Familia  @relation(fields: [familiaId], references: [id], onDelete: Cascade)
  contaOrigem    Conta    @relation("TransferenciasSaida", fields: [contaOrigemId], references: [id], onDelete: Cascade)
  contaDestino   Conta    @relation("TransferenciasEntrada", fields: [contaDestinoId], references: [id], onDelete: Cascade)
}

// Regra de recorrência mensal (aluguel, assinatura, salário...). As ocorrências não
// nascem daqui direto — são materializadas como Transacao normais (ver
// utils/materializeRecorrencias.js) sempre que o usuário acessa a tela de recorrências
// ou a lista de transações, sem depender de nenhum job/cron rodando no servidor.
model Recorrencia {
  id         Int         @id @default(autoincrement())
  usuarioId  Int
  familiaId  Int
  tipo       String
  valor      Decimal     @db.Decimal(12, 2)
  categoria  String
  descricao  String      @default("")
  diaDoMes   Int
  dataInicio String
  dataFim    String?
  ativa      Boolean     @default(true)
  createdAt  DateTime    @default(now())
  // Posição manual na tela (arrastar e soltar) — menor = mais acima. Reordenar grava
  // -n..-1 (ver utils/reorderLista.js), então registro novo (default 0) entra no fim sem
  // ninguém calcular "próxima posição"; empates caem no createdAt asc (ordem de criação).
  ordem      Int         @default(0)
  usuario    Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  familia    Familia     @relation(fields: [familiaId], references: [id], onDelete: Cascade)
  transacoes Transacao[]
  contaId    Int
  conta      Conta       @relation(fields: [contaId], references: [id], onDelete: Cascade)
}

model Meta {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  familiaId Int
  titulo    String
  valorAlvo Decimal  @db.Decimal(12, 2)
  prazo     String?
  createdAt DateTime @default(now())
  // Posição manual na tela (arrastar e soltar) — menor = mais acima. Reordenar grava
  // -n..-1 (ver utils/reorderLista.js), então registro novo (default 0) entra no fim sem
  // ninguém calcular "próxima posição"; empates caem no createdAt asc (ordem de criação).
  ordem     Int      @default(0)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  familia   Familia  @relation(fields: [familiaId], references: [id], onDelete: Cascade)
  aportes   Aporte[]
}

// Contribuições registradas manualmente pelo usuário — valorAtual de uma Meta é sempre
// a soma dos aportes, nunca um campo redundante na Meta (evita os dois ficarem dessincronizados).
model Aporte {
  id        Int      @id @default(autoincrement())
  metaId    Int
  valor     Decimal  @db.Decimal(12, 2)
  data      String
  descricao String   @default("")
  createdAt DateTime @default(now())
  meta      Meta     @relation(fields: [metaId], references: [id], onDelete: Cascade)
}

// Limite mensal fixo por categoria — vale todo mês até o usuário editar (não é um
// registro por mês). O gasto do mês é sempre calculado a partir das Transacoes, nunca
// guardado aqui.
model Orcamento {
  id                   Int      @id @default(autoincrement())
  usuarioId            Int
  familiaId            Int
  categoria            String
  valorLimite          Decimal  @db.Decimal(12, 2)
  createdAt            DateTime @default(now())
  // Posição manual na tela (arrastar e soltar) — menor = mais acima. Reordenar grava
  // -n..-1 (ver utils/reorderLista.js), então registro novo (default 0) entra no fim sem
  // ninguém calcular "próxima posição"; empates caem no createdAt asc (ordem de criação).
  ordem                Int      @default(0)
  usuario              Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  familia              Familia  @relation(fields: [familiaId], references: [id], onDelete: Cascade)
  // Mês (YYYY-MM) do último aviso de orçamento estourado já enviado por e-mail — evita
  // mandar um e-mail novo a cada transação que continua estourando o mesmo orçamento no mês.
  ultimaNotificacaoMes String?

  @@unique([familiaId, categoria])
}

// Etiqueta pra agrupar transações que já existem no dashboard normal em um evento (ex:
// "Viagem Rio 2026") — não é um livro-caixa separado, gasto/recebido do evento são sempre
// recalculados a partir das Transacoes vinculadas, nunca guardados aqui.
model Evento {
  id                 Int         @id @default(autoincrement())
  usuarioId          Int
  familiaId          Int
  nome               String
  dataInicio         String
  dataFim            String?
  orcamento          Decimal?    @db.Decimal(12, 2)
  // "ativo" | "encerrado" — encerrar só tira o evento do seletor de novas transações,
  // não desvincula as que já existem nem impede reabrir.
  status             String      @default("ativo")
  createdAt          DateTime    @default(now())
  // Posição manual na tela (arrastar e soltar) — menor = mais acima. Reordenar grava
  // -n..-1 (ver utils/reorderLista.js), então registro novo (default 0) entra no fim sem
  // ninguém calcular "próxima posição"; empates caem no createdAt asc (ordem de criação).
  ordem              Int         @default(0)
  usuario            Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  familia            Familia     @relation(fields: [familiaId], references: [id], onDelete: Cascade)
  transacoes         Transacao[]
  // Aviso por e-mail já disparado pro teto (orcamento) deste evento — flag única (não um
  // mês como em Orcamento.ultimaNotificacaoMes), porque o evento tem um teto vitalício, não mensal.
  notificacaoEnviada Boolean     @default(false)
}

// Grupo pra dividir despesas entre várias pessoas e calcular quem deve quem (estilo
// Splitwise) — conceito bem diferente de Familia: um Usuario pode estar em vários grupos
// (não em só um) e um grupo pode incluir convidados sem conta (ver GrupoMembro).
model Grupo {
  id               Int              @id @default(autoincrement())
  nome             String
  // Código curto pra outra pessoa entrar, mesmo padrão de Familia.codigo.
  codigo           String           @unique
  criadorUsuarioId Int
  criador          Usuario          @relation("GrupoCriador", fields: [criadorUsuarioId], references: [id], onDelete: Restrict)
  createdAt        DateTime         @default(now())
  membros          GrupoMembro[]
  despesas         DespesaGrupo[]
  pagamentos       PagamentoGrupo[]
}

// Primeira tabela de associação N:N do projeto — um Usuario pode estar em vários grupos
// (diferente de Familia, que é 1:1 com Usuario). usuarioId nulo = convidado sem conta,
// identificado só por nomeConvidado. NULLs não colidem em @@unique no Postgres, então
// vários convidados (usuarioId null) convivem no mesmo grupo sem violar a constraint —
// só um Usuario de verdade não pode entrar duas vezes no mesmo grupo.
model GrupoMembro {
  id                  Int              @id @default(autoincrement())
  grupoId             Int
  grupo               Grupo            @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  usuarioId           Int?
  usuario             Usuario?         @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  nomeConvidado       String?
  // "admin" | "membro" — admin remove membros, exclui o grupo; qualquer membro lança
  // despesa e adiciona convidado.
  papel               String           @default("membro")
  createdAt           DateTime         @default(now())
  // Posição do grupo na lista de Grupos DESTE usuário (arrastar e soltar) — fica na
  // associação, não no Grupo, porque cada membro organiza a própria lista. Mesma regra de
  // Conta.ordem: -n..-1 depois de reordenar, 0 = fim; empate cai no createdAt asc.
  ordem               Int              @default(0)
  despesasPagas       DespesaGrupo[]   @relation("PagoPor")
  divisoes            DivisaoDespesa[]
  pagamentosFeitos    PagamentoGrupo[] @relation("PagamentoDe")
  pagamentosRecebidos PagamentoGrupo[] @relation("PagamentoPara")

  @@unique([grupoId, usuarioId])
}

model DespesaGrupo {
  id                 Int              @id @default(autoincrement())
  grupoId            Int
  grupo              Grupo            @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  descricao          String
  valorTotal         Decimal          @db.Decimal(12, 2)
  // Moeda em que a despesa foi paga (ver utils/moedas.js) — cada despesa tem a sua, porque
  // uma viagem mistura moedas (passagem em R$, jantar em €). O "quem deve quem" nunca
  // converte entre moedas: é separado por moeda (ver utils/calcularSaldosGrupo.js).
  moeda              String           @default("BRL")
  data               String
  // Restrict (não Cascade/SetNull): impede apagar um GrupoMembro que já pagou alguma
  // despesa — perderia o histórico de quem realmente desembolsou o dinheiro.
  pagoPorMembroId    Int
  pagoPor            GrupoMembro      @relation("PagoPor", fields: [pagoPorMembroId], references: [id], onDelete: Restrict)
  criadoPorUsuarioId Int
  criadoPor          Usuario          @relation("DespesaGrupoCriador", fields: [criadoPorUsuarioId], references: [id], onDelete: Restrict)
  createdAt          DateTime         @default(now())
  divisoes           DivisaoDespesa[]
  transacoes         Transacao[]
}

// Uma linha por participante de uma despesa, incluindo quem pagou (se ele também fizer
// parte do rateio) — soma de valorDevido sempre == valorTotal da despesa. O saldo "quem
// deve quem" (utils/calcularSaldosGrupo.js) ignora a linha do próprio pagador (não deve
// pra si mesmo); ele nunca é excluído aqui, pra manter esse invariante simples e auditável.
model DivisaoDespesa {
  id             Int          @id @default(autoincrement())
  despesaGrupoId Int
  despesa        DespesaGrupo @relation(fields: [despesaGrupoId], references: [id], onDelete: Cascade)
  membroId       Int
  // Restrict: mesma razão do pagoPor acima — não pode sumir um participante de uma
  // despesa já lançada sem quebrar a soma histórica.
  membro         GrupoMembro  @relation(fields: [membroId], references: [id], onDelete: Restrict)
  valorDevido    Decimal      @db.Decimal(12, 2)

  @@unique([despesaGrupoId, membroId])
}

// Uma quitação registrada entre dois membros — "de" pagou "para" fora do app (dinheiro,
// Pix, o que for), e isso abate o saldo calculado em utils/calcularSaldosGrupo.js. Mesmo
// princípio das despesas: nunca persiste o saldo em si, só o evento que o compõe.
// Restrict nos dois membros, mesma razão do pagoPor/DivisaoDespesa.membro acima: não pode
// sumir o histórico de quem pagou/recebeu.
model PagamentoGrupo {
  id                 Int         @id @default(autoincrement())
  grupoId            Int
  grupo              Grupo       @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  deMembroId         Int
  de                 GrupoMembro @relation("PagamentoDe", fields: [deMembroId], references: [id], onDelete: Restrict)
  paraMembroId       Int
  para               GrupoMembro @relation("PagamentoPara", fields: [paraMembroId], references: [id], onDelete: Restrict)
  valor              Decimal     @db.Decimal(12, 2)
  // Abate o saldo "quem deve quem" só dessa moeda.
  moeda              String      @default("BRL")
  // Só quando a dívida foi quitada em outra moeda (ex: devia € 40, pagou R$ 250 por Pix):
  // o que de fato mudou de mão. Informado pelo usuário, nunca calculado — o saldo continua
  // abatendo "valor" em "moeda"; isto é só o registro do pagamento real.
  moedaPagamento     String?
  valorPagamento     Decimal?    @db.Decimal(12, 2)
  data               String
  criadoPorUsuarioId Int
  criadoPor          Usuario     @relation("PagamentoGrupoCriador", fields: [criadoPorUsuarioId], references: [id], onDelete: Restrict)
  createdAt          DateTime    @default(now())
  transacoes         Transacao[]
}

// Cotação de câmbio pra converter contas em moeda estrangeira pro total consolidado em
// R$ (Dashboard/Relatórios). Global (sem familiaId) — cotação é dado de mercado, não
// pertence a uma família específica. Atualizada manualmente (botão "Atualizar cotações"
// em Contas), nunca por cron — ver utils/currency.js e routes/cambio.js.
model TaxaCambio {
  id           Int      @id @default(autoincrement())
  moeda        String   @unique
  taxaParaBRL  Decimal  @db.Decimal(12, 6)
  atualizadoEm DateTime @default(now())
}
