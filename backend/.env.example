PORT=3001
JWT_SECRET=troque_por_um_segredo_forte
FRONTEND_URL=http://localhost:5173

# String de conexão do PostgreSQL. Localmente, use um Postgres próprio (Docker, instalação
# local, ou uma instância gratuita na nuvem, ex: Neon/Supabase). Em produção, use a connection
# string fornecida pelo Neon (ou o provedor de banco escolhido).
DATABASE_URL=postgresql://usuario:senha@localhost:5432/geldtrack?schema=public

# SMTP — usado para enviar o e-mail de redefinição de senha.
# Exemplo com Gmail: crie uma "App Password" em https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@gmail.com
SMTP_PASS=sua_app_password
EMAIL_FROM=GeldTrack <seu@gmail.com>

# Open Finance (sincronização automática com bancos via Pluggy) — crie uma conta grátis
# em pluggy.ai, uma Application, e cole o Client ID/Secret abaixo. Sem essas variáveis,
# o servidor sobe normalmente; só a tela de "Conectar banco" fica indisponível.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# URL pública do backend (ex: https://seu-backend.onrender.com) — usada só para registrar
# o webhook da Pluggy, que precisa de uma URL acessível de fora (não funciona com
# localhost). Sem isso, a sincronização automática por webhook fica desligada, mas o
# botão "Sincronizar agora" continua funcionando normalmente.
BACKEND_URL=

# Resumo semanal/mensal por e-mail — segredo que o workflow agendado do GitHub Actions
# (.github/workflows/resumo-email.yml) manda no cabeçalho x-cron-secret. Gere um valor
# aleatório longo e use o mesmo no segredo CRON_SECRET do repositório. Sem isso, a rota
# POST /api/resumos/enviar responde 503 e nenhum resumo é enviado.
CRON_SECRET=
